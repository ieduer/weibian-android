<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="weibian-learning.db" />
        <include domain="sharedpref" path="weibian_progress.xml" />
        <exclude domain="sharedpref" path="weibian_secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="weibian-learning.db" />
        <include domain="sharedpref" path="weibian_progress.xml" />
        <exclude domain="sharedpref" path="weibian_secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
